{
  "name": "ttv-tts",
  "private": true,
  "version": "2.0.0",
  "description": "TTV-TTS – your Twitch chat, read aloud by your own Voice Creator Pro voices",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "proxy:dev": "npm run tauri --workspace @ttv-tts/proxy -- dev",
    "proxy:ui": "npm run dev --workspace @ttv-tts/proxy",
    "proxy:build": "npm run tauri --workspace @ttv-tts/proxy -- build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "icons": "node scripts/icons/export.mjs",
    "docs": "node docs/site/build.mjs",
    "docs:serve": "node docs/site/build.mjs --serve"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "marked": "^18.1.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
