{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TTV-TTS Proxy",
  "version": "2.4.0",
  "identifier": "io.github.zcarecrow.ttvtts.proxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TTV-TTS Proxy",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "ZcarecroW",
    "copyright": "© 2026 ZcarecroW – MIT License",
    "category": "Utility",
    "shortDescription": "Makes Voice Creator Pro available to TTV-TTS on other PCs",
    "longDescription": "TTV-TTS Proxy runs on the PC with Voice Creator Pro and makes it available to TTV-TTS on your gaming PC: encrypted, with pairing, LAN discovery, VCP start/watchdog, system monitor and firewall setup.",
    "homepage": "https://zcarecrow.github.io/TTV-TTS/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNjcyNjg4OTEwRDg3RjkKUldUNWh3MlJpQ1puTHlJNFh1VGUxS2wzTzU0VmVDRVFydkxsdDRzMEJ6QStXcjNnTldJais1MlMK",
      "endpoints": [
        "https://github.com/ZcarecroW/TTV-TTS/releases/latest/download/latest-proxy.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
