{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TTV-TTS",
  "version": "2.1.0-alpha.1",
  "identifier": "io.github.zcarecrow.ttvtts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TTV-TTS",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "ZcarecroW",
    "copyright": "© 2026 ZcarecroW – MIT License",
    "category": "Utility",
    "shortDescription": "Your Twitch chat, read aloud by your own Voice Creator Pro voices",
    "longDescription": "TTV-TTS reads Twitch chat aloud with natural AI voices from Voice Creator Pro – on this PC or on a second PC through TTV-TTS Proxy. Voice presets, per-viewer voices, many languages and lots of streamer conveniences.",
    "homepage": "https://zcarecrow.github.io/TTV-TTS/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNjcyNjg4OTEwRDg3RjkKUldUNWh3MlJpQ1puTHlJNFh1VGUxS2wzTzU0VmVDRVFydkxsdDRzMEJ6QStXcjNnTldJais1MlMK",
      "endpoints": [
        "https://github.com/ZcarecroW/TTV-TTS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
